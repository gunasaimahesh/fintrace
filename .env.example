# FalkorDB Connection (Local Docker or FalkorDB Cloud)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
DEFAULT_TENANT=acme-pay

# LLM Provider (OpenAI-compatible endpoint: OpenAI, Groq, Gemini, OpenRouter, or Anthropic)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Space requests to stay under a provider's per-minute limit (0 = no pacing), and retries on 429/5xx.
LLM_REQUESTS_PER_MINUTE=0
LLM_MAX_RETRIES=4

# Public demo: visitors share each tenant's graph. Caps model runs (past the cap, investigations use the
# deterministic planner), bounds concurrent investigations, keeps hunters deterministic and spaces out resets.
PUBLIC_DEMO=0
DEMO_LLM_RUNS_PER_HOUR=20
DEMO_LLM_RUNS_PER_VISITOR_PER_HOUR=5
DEMO_MAX_INVESTIGATIONS=4
DEMO_RESET_COOLDOWN_S=30
