# FalkorDB Connection (Local Docker or FalkorDB Cloud)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
DEFAULT_TENANT=acme-pay

# LLM Provider (OpenAI-compatible endpoint: OpenAI, Groq, Gemini, OpenRouter, or Anthropic)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
